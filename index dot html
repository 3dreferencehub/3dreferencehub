<!DOCTYPE html>
<html lang="hi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>3D रेफरेंस हब</title>
    <style>
        body { font-family: Arial, sans-serif; margin: 0; padding: 20px; background-color: #f4f4f4; }
        header { text-align: center; margin-bottom: 20px; }
        .gallery { display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); gap: 15px; }
        .card { background: white; padding: 10px; border-radius: 8px; box-shadow: 0 2px 5px rgba(0,0,0,0.1); }
        .card img { max-width: 100%; border-radius: 4px; }
        .buttons { display: flex; justify-content: space-between; margin-top: 10px; }
        .btn { padding: 8px; background-color: #007bff; color: white; border: none; border-radius: 4px; cursor: pointer; text-decoration: none; font-size: 14px; }
        .btn-share { background-color: #25d366; }
    </style>
</head>
<body>
    <header>
        <h1>3D रेफरेंस हब</h1>
    </header>
    <div class="gallery" id="photoGallery">
        <!-- फोटो यहाँ दिखेंगी -->
    </div>
</body>
</html>
